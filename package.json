{
  "name": "noitis-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-local-env.mjs && vite",
    "build": "node scripts/generate-publication-files.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "check:content": "node scripts/verify-content.mjs",
    "check": "npm run build && npm run check:content"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
